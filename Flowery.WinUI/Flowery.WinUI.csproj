<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.WinUI</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>Library</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- WMC1510 asks for x:DataType on every {Binding} of the templates. They bind to dependency properties
         (TemplatedParent, ElementName, a brush resource) or to the [Bindable] ThemePreviewInfo, which WinUI resolves
         through the generated XAML metadata, also in a NativeAOT app. -->
    <NoWarn>$(NoWarn);WMC1510</NoWarn>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <PackageId>Flowery.WinUI</PackageId>
    <Description>Themed native WinUI 3 controls for Windows.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>winui;windows;theme;ui;xaml</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md</PackageReleaseNotes>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="WebAssets\*.js" LogicalName="Flowery.WebAssets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" />
    <Content Update="Assets\Patterns\**\*.svg" PackagePath="lib\$(TargetFramework)\$(AssemblyName)\%(Identity)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Update="ThirdPartyNotices\Xtreme.Components.txt" Pack="true" PackagePath="licenses\" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
</Project>
