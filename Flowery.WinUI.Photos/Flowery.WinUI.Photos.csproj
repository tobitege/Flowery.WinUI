<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.WinUI.Photos</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Flowery Photos</ApplicationTitle>
    <ApplicationIcon>..\Flowery.WinUI.Gallery\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- A restore for the runtime (Directory.Build.props always sets one) downloads no ASP.NET Core or Windows Desktop
         runtime packs, which the SDK fetches in case a reference needs them; the app uses neither framework. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <!-- publish_windows.ps1 -Aot: a NativeAOT publish. The property is not PublishAot itself, which as a global
       property would also turn the referenced libraries into AOT builds. The native symbols (about 100 MB) stay in
       the build output; stack traces in crash.log keep their method names without them. -->
  <PropertyGroup Condition="'$(FloweryPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.WinUI\Flowery.WinUI.csproj" />
    <PackageReference Include="Microsoft.Graphics.Win2D" />
    <Compile Include="..\Flowery.WinUI.Gallery\NativeWindowPlacement.cs" Link="NativeWindowPlacement.cs" />
    <Compile Include="..\Flowery.WinUI.Gallery\ExecutableIcon.cs" Link="ExecutableIcon.cs" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="$(AssemblyName).Localization.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\*.ttf;..\Flowery.WinUI.Gallery.Core\Assets\Fonts\*.otf;..\Flowery.WinUI.Gallery.Core\Assets\Fonts\StaticFonts-OFL.txt"
             Exclude="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\*-Variable.ttf">
      <Link>Assets\Fonts\%(Filename)%(Extension)</Link>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\Flowery.WinUI.Gallery.Core\Assets\wallpaper_*.jpg;..\Flowery.WinUI.Gallery.Core\Assets\tile_*.jpg;..\Flowery.WinUI.Gallery.Core\Assets\placeholder1.jpg">
      <Link>Assets\Samples\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Assets\*.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- PhotosResources.xaml uses these fonts. One license file covers all five. -->
  <ItemGroup>
    <RequiredFontAsset Include="NotoSans-Regular.ttf;NotoSansSC-Regular.otf;NotoSansJP-Regular.otf;NotoSansKR-Regular.otf;NotoSansArabic-Regular.ttf;StaticFonts-OFL.txt" />
  </ItemGroup>
  <Import Project="..\Flowery.WinUI.FontAssets.targets" />
</Project>
