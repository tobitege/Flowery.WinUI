<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.WinUI.Gallery</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Flowery.WinUI Gallery</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app_icon.ico</ApplicationIcon>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- A publish for a runtime downloads no ASP.NET Core or Windows Desktop runtime pack, which the SDK fetches in
         case a reference needs them; the app uses neither framework. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.Integrations.WinUI\Flowery.Integrations.WinUI.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Gallery.Core\Flowery.WinUI.Gallery.Core.csproj" />
    <ProjectReference Include="..\Flowery.WinUI\Flowery.WinUI.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Kanban\Flowery.WinUI.Kanban.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Win2D\Flowery.WinUI.Win2D.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.RuntimeTests\Flowery.WinUI.RuntimeTests.csproj" />
  </ItemGroup>

  <Import Project="..\Flowery.WinUI.GalleryAssets.props" />
  <Import Project="..\Flowery.WinUI.PatternAssets.props" />

  <!-- The Gallery uses variable fonts. Other apps still use the shared static fonts. -->
  <ItemGroup>
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\NotoSans-Regular.ttf" />
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\NotoSansArabic-Regular.ttf" />
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\NotoSansSC-Regular.otf" />
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\NotoSansJP-Regular.otf" />
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\NotoSansKR-Regular.otf" />
    <Content Remove="..\Flowery.WinUI.Gallery.Core\Assets\Fonts\StaticFonts-OFL.txt" />
  </ItemGroup>

  <!-- Without MSIX tooling, publish omits the app's own PRI file, and the app cannot load its XAML. -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
