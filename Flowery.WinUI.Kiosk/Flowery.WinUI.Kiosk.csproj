<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <RootNamespace>Flowery.WinUI.Kiosk</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <OutputType>WinExe</OutputType>
    <ApplicationTitle>Flowery.WinUI Kiosk</ApplicationTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Flowery.WinUI.Gallery\app_icon.ico</ApplicationIcon>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
    <NoWarn>$(NoWarn);PRI263</NoWarn>
    <IsPackable>false</IsPackable>
    <!-- A restore for the runtime (Directory.Build.props always sets one) downloads no ASP.NET Core or Windows Desktop
         runtime packs, which the SDK fetches in case a reference needs them; the app uses neither framework. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>
  <!-- publish_windows.ps1 -Aot: a NativeAOT publish. The property is not PublishAot itself, which as a global
       property would also turn the referenced libraries into AOT builds. The native symbols stay in the build output. -->
  <PropertyGroup Condition="'$(FloweryPublishAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowery.WinUI\Flowery.WinUI.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Win2D\Flowery.WinUI.Win2D.csproj" />
    <ProjectReference Include="..\Flowery.WinUI.Gallery.Core\Flowery.WinUI.Gallery.Core.csproj" />
    <Compile Include="..\Flowery.WinUI.Gallery\NativeWindowPlacement.cs" Link="NativeWindowPlacement.cs" />
    <Compile Include="..\Flowery.WinUI.Gallery\ExecutableIcon.cs" Link="ExecutableIcon.cs" />
    <Content Include="Assets\Kiosk\*.svg" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="..\Flowery.WinUI.GalleryAssets.props" />
  <Import Project="..\Flowery.WinUI.PatternAssets.props" />

  <!-- Without MSIX tooling, publish omits the app's own PRI file, and the app cannot load its XAML. -->
  <Target Name="PublishProjectPriFile" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
