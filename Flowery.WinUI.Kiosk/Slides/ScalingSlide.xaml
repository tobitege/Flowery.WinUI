<UserControl
    x:Class="Flowery.WinUI.Kiosk.Slides.ScalingSlide"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:daisy="using:Flowery.Controls"
    xmlns:services="using:Flowery.Services"
    services:FloweryScaleManager.EnableScaling="True">

    <Grid Padding="24,16,24,120">
        <!-- Main Content -->
        <Grid x:Name="DemoLayout" ColumnSpacing="24" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Left: Header and zoom level - excluded from scaling. The panel needs about 390 pixels of height; the
                 Viewbox shrinks it in a smaller window, where it would otherwise reach past the slide. -->
            <Viewbox StretchDirection="DownOnly" VerticalAlignment="Center">
                <StackPanel x:Name="ZoomPanel" Spacing="12" Width="180" HorizontalAlignment="Center" VerticalAlignment="Center" services:FloweryScaleManager.EnableScaling="False">
                    <StackPanel Spacing="6">
                        <TextBlock Text="RUNTIME SCALING" HorizontalAlignment="Center" Foreground="{ThemeResource DaisyPrimaryBrush}" FontWeight="Bold" CharacterSpacing="200" FontSize="10" />
                        <TextBlock Text="FloweryScaleManager Demo" TextWrapping="Wrap" TextAlignment="Center" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                        <TextBlock Text="Watch controls scale in real-time" TextWrapping="Wrap" TextAlignment="Center" FontSize="12" Opacity="0.7" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                    </StackPanel>
                    <daisy:DaisyRadialProgress x:Name="ZoomProgress" Value="50" Maximum="200" Size="Medium" Variant="Primary" ShowValue="True" Width="140" Height="140" />
                
                    <TextBlock Text="FloweryScaleManager" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                    <TextBlock Text="Real-time UI scaling" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                </StackPanel>
            </Viewbox>

            <!-- Right: Demo Controls that will scale -->
            <daisy:DaisyCard x:Name="DemoCard" Grid.Column="1" BodyPadding="18" MaxWidth="640" VerticalAlignment="Center">
                <StackPanel x:Name="DemoCardContent" Spacing="12">
                    <TextBlock x:Name="DemoTitle" Text="Interactive Controls" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource DaisyBaseContentBrush}" />
                    
                    <daisy:DaisyInput x:Name="DemoInput" Label="SAMPLE INPUT" PlaceholderText="Text scales..." Variant="Bordered" Size="Small" />
                    
                    <daisy:WrapPanel x:Name="DemoButtonRow" Orientation="Horizontal" Spacing="8">
                        <daisy:DaisyButton x:Name="DemoButton1" Content="Primary" Variant="Primary" Size="Small" />
                        <daisy:DaisyButton x:Name="DemoButton2" Content="Secondary" Variant="Secondary" Size="Small" />
                        <daisy:DaisyButton x:Name="DemoButton3" Content="Ghost" Variant="Ghost" Size="Small" />
                    </daisy:WrapPanel>
                    
                    <daisy:DaisyProgress x:Name="DemoProgress" Value="65" Variant="Accent" Height="6" />
                    
                    <daisy:WrapPanel x:Name="DemoBadgeRow" Orientation="Horizontal" Spacing="6">
                        <daisy:DaisyBadge x:Name="DemoBadge1" Content="SCALES" Variant="Primary" Size="ExtraSmall" />
                        <daisy:DaisyBadge x:Name="DemoBadge2" Content="IN" Variant="Secondary" Size="ExtraSmall" />
                        <daisy:DaisyBadge x:Name="DemoBadge3" Content="REAL-TIME" Variant="Accent" Size="ExtraSmall" />
                    </daisy:WrapPanel>
                </StackPanel>
            </daisy:DaisyCard>
        </Grid>
    </Grid>
</UserControl>
